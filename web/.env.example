DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-generated-64-char-hex-string"

# AES-256-GCM key (32 bytes, hex) used to encrypt face embeddings at rest.
# Generate your own the same way as SESSION_SECRET above.
FACE_EMBEDDING_KEY="replace-with-a-generated-64-char-hex-string"

# Base URL of the face-engine (Python/FastAPI) service.
FACE_ENGINE_URL="http://127.0.0.1:8000"

# Base URL of the optional scene-engine (RelateAnything) service used by the
# Security dashboard's scene analysis. If it isn't running, Security falls
# back to face recognition only.
SCENE_ENGINE_URL="http://127.0.0.1:8001"
